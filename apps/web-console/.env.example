# GodGesture Web 控制台 —— 环境变量占位(复制为 .env 后填写)
# GodGesture Web Console —— environment variable template (copy to .env)

# 后端基址 / Backend base URL.
# 留空 = 同源(开发时走 vite 代理 /api;生产走反向代理的 /api)。
# Leave empty for same-origin (vite proxy in dev, reverse proxy in prod).
# 跨域后端示例 / Cross-origin backend example:
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# 说明:OAuth(GitHub / Google / 微信 / QQ)的 client id / secret 属于服务端凭证,
#       在 apps/server 的 .env 配置,前端不持有任何 OAuth 密钥。
# Note: OAuth (GitHub / Google / WeChat / QQ) client id/secret are server-side
#       credentials configured in apps/server's .env; the frontend holds no OAuth secrets.
