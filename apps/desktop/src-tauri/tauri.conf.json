{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GodGesture",
  "version": "0.1.0",
  "identifier": "com.godgesture.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:14200",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GodGesture",
        "width": 980,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMUU3QUE5MTUxODUyNTgKUldSWVVoZ1ZxWG9lMjdMZ1NnWXE3SXpzZzIrVHdJNHB3d2xrM0kyM0c2RHVoTEE1aC9ha0hiV2cK",
      "endpoints": [
        "https://github.com/Mr-BeanSir/GodGesture/releases/latest/download/latest.json"
      ]
    }
  }
}
