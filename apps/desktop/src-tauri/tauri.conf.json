{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GodGesture",
  "version": "0.2.1",
  "identifier": "com.godgesture.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:14200",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GodGesture",
        "width": 980,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/node-toolchain"
    ],
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzOUJDMDNGNTk4RTY4QUYKUldTdmFJNVpQOENia3pXb0FNbUo1WVhUVVg0OVB1Nk1Db2lTT1U1c25NandJbnhMQTFPKzYweisK",
      "endpoints": [
        "https://github.com/Mr-BeanSir/GodGesture/releases/latest/download/latest.json"
      ]
    }
  }
}
