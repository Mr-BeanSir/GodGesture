# Server origin used by the desktop account and synchronization client.
# Production builds must provide the deployed HTTPS origin.
GODGESTURE_API=http://127.0.0.1:3000

# Public GitHub distribution locations. Override these only for an intentional
# repository migration; production template payloads must remain HTTPS.
VITE_GESTURE_TEMPLATE_CATALOG_URL=https://github.com/Mr-BeanSir/gesture-templates/releases/latest/download/catalog.json
VITE_GESTURE_TEMPLATE_REPOSITORY_URL=https://github.com/Mr-BeanSir/gesture-templates
VITE_GODGESTURE_REPOSITORY_URL=https://github.com/Mr-BeanSir/GodGesture

# The native updater endpoint is compiled by Cargo from GODGESTURE_UPDATE_ENDPOINT.
# Its default is the latest GitHub Release latest.json and it must use HTTPS.
