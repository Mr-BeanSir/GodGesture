# Official Server origin used by the desktop account, synchronization client, and public template catalog.
# Production builds must provide the deployed HTTPS origin.
GODGESTURE_API=http://127.0.0.1:3000

# Public GitHub distribution locations for the updater and official plugin catalog.
# Public gesture templates use the official Server origin configured above.
VITE_GODGESTURE_PLUGIN_CATALOG_URL=https://raw.githubusercontent.com/Mr-BeanSir/GodGesture-Plugins/main/catalog.min.json
VITE_GODGESTURE_REPOSITORY_URL=https://github.com/Mr-BeanSir/GodGesture

# The native updater endpoint is compiled by Cargo from GODGESTURE_UPDATE_ENDPOINT.
# Its default is the latest GitHub Release latest.json and it must use HTTPS.
