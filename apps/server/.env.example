# ============================================================
# GodGesture 后端环境变量(复制为 .env 后填写)
# 所有外部凭证一律走环境变量,不写死到代码里(CLAUDE.md)
# ============================================================

# 运行环境:development | test | production
NODE_ENV=development

# HTTP 监听端口(生产环境仅暴露给 1Panel 反向代理,见 docker-compose.prod.yml)
PORT=3000

# PostgreSQL 连接串(本地开发配合 docker-compose.dev.yml)
DATABASE_URL=postgresql://godgesture:godgesture@localhost:5432/godgesture?schema=public

# JWT 签名密钥(HS256)。生产环境必须换成长随机串,例如:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret

# 访问令牌有效期(秒),默认 900 = 15 分钟
ACCESS_TOKEN_TTL_SEC=900
# 刷新令牌有效期(天),默认 30 天(轮换发放、按设备可撤销)
REFRESH_TOKEN_TTL_DAYS=30

# 服务对外基址(用于拼 OAuth 回调地址)。
# 生产 = 1Panel 反代后的 https 域名,如 https://api.example.com
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Web 控制台源(M7):同时用于 CORS 放行与 OAuth redirect_uri 白名单
# WEB_CONSOLE_ORIGIN=https://console.example.com

# 额外 CORS 源,逗号分隔(Tauri WebView 源 tauri://localhost 已默认放行)
# CORS_ORIGINS=

# ---------------- OAuth:GitHub(先行) ----------------
# GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL 填:{PUBLIC_BASE_URL}/api/v1/auth/oauth/github/callback
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# ---------------- OAuth:Google(先行) ----------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# 授权重定向 URI 填:{PUBLIC_BASE_URL}/api/v1/auth/oauth/google/callback
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# ---------------- OAuth:微信(留配置位,默认停用) ----------------
# 微信开放平台「网站应用」(扫码登录)。未开启时相关端点返回 501。
# OAUTH_WECHAT_ENABLED=false
# OAUTH_WECHAT_APP_ID=
# OAUTH_WECHAT_APP_SECRET=

# ---------------- OAuth:QQ(留配置位,默认停用) ----------------
# QQ 互联「网站应用」。未开启时相关端点返回 501。
# OAUTH_QQ_ENABLED=false
# OAUTH_QQ_APP_ID=
# OAUTH_QQ_APP_SECRET=

# ---------------- 仅生产 compose 使用(docker-compose.prod.yml) ----------------
# PostgreSQL 密码(compose 会用它拼内网 DATABASE_URL 并覆盖上面的本地串)
# POSTGRES_PASSWORD=
# 宿主机回环端口(1Panel 反代目标),默认 3000
# APP_PORT=3000
