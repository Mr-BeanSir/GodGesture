{
  "name": "godgesture",
  "private": true,
  "version": "0.2.0",
  "description": "GodGesture — independent cross-platform mouse gesture tool (Tauri) with cloud sync",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "vue-demi"
    ]
  },
  "scripts": {
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:server": "node scripts/dev-server.mjs",
    "build:desktop": "pnpm --filter @godgesture/desktop tauri build",
    "build:server": "pnpm --filter @godgesture/server build",
    "build:shared": "pnpm --filter @godgesture/shared build",
    "fetch:node-toolchain": "node scripts/fetch-node-toolchain.mjs",
    "release": "node scripts/release.mjs",
    "validate:plugins": "node scripts/validate-plugin-demo.mjs && node distribution/plugins/scripts/validate-content.mjs",
    "validate:plugin-demo": "node scripts/validate-plugin-demo.mjs",
    "validate:release": "node --test scripts/__tests__/release.test.mjs scripts/__tests__/pr-title.test.mjs scripts/__tests__/desktop-release.test.mjs scripts/__tests__/desktop-api-origin.test.mjs && node scripts/validate-desktop-release.mjs",
    "test:repository-layout": "node --test scripts/__tests__/repository-layout.test.mjs",
    "generate:api": "pnpm --filter @godgesture/shared build && pnpm --filter @godgesture/server openapi:document && node scripts/generate-api.mjs && pnpm --filter @godgesture/shared build",
    "check:api": "pnpm --filter @godgesture/shared build && pnpm --filter @godgesture/server openapi:check && node scripts/generate-api.mjs --check",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@release-it/bumper": "^8.0.0",
    "openapi-typescript": "^7.13.0",
    "release-it": "^21.0.2",
    "semver": "^7.8.5",
    "yaml": "2.9.0"
  }
}
