{
  "name": "@godgesture/sdk",
  "version": "0.1.0",
  "description": "TypeScript contract and helpers for GodGesture Node plugins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "sideEffects": false,
  "keywords": [
    "godgesture",
    "plugin",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr-BeanSir/GodGesture.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Mr-BeanSir/GodGesture#readme",
  "bugs": {
    "url": "https://github.com/Mr-BeanSir/GodGesture/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
